{
  "name": "captcha-anotacion",
  "version": "1.0.0",
  "description": "Portal de anotación estilo CAPTCHA",
  "main": "src/index.ts",
  "scripts": {
    "db:generate": "drizzle-kit generate:mysql",
    "db:migrate": "tsx --env-file=.env src/data/migrate.ts",
    "db:seed": "tsx --env-file=.env src/data/seed.ts",
    "prestart:dev": "npm run db:migrate && npm run db:seed",
    "start:dev": "tsx watch --env-file=.env src/index.ts",
    "dev": "npm run prestart:dev && npm run start:dev",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "check": "biome check .",
    "format": "biome format --write .",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "up": "docker compose up --build -d"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "express": "^4.19.2",
    "minio": "^7.1.3",
    "multer": "^2.0.2",
    "mysql2": "^3.9.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.7.3",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.12.7",
    "drizzle-kit": "^0.20.17",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
