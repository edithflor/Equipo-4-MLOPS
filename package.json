{
  "name": "equipo-4-mlops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/server.ts",
    "test": "npm run test:tdd && npm run test:gherkin",
    "test:tdd": "tsx --test tests/tdd/app.test.ts",
    "test:gherkin": "tsx tests/gherkin/run-gherkin.ts",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.0",
    "express": "^4.19.2",
    "mysql2": "^3.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0"
  }
}
